cc = cc
cflags = -Wall -Wextra -std=c11

rule cc
  command = mkdir -p build && $cc $cflags -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CC $out

rule archive
  command = ar rcs $out $in
  description = AR $out

rule link
  command = $cc $in -o $out
  description = LINK $out

build build/greeter.o: cc greeter.c
build build/libgreeter.a: archive build/greeter.o
build build/main.o: cc main.c
build build/app: link build/main.o build/libgreeter.a
build all: phony build/app

default all
